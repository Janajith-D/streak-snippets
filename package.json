{
  "name": "streak-snippets",
  "displayName": "Streak Snippets",
  "description": "Snippets, commands, and developer productivity tools for the Streak.js React framework",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "streak-snippets.showSnippets",
        "title": "Streak: Show Snippet List"
      },
      {
        "command": "streak-snippets.createComponent",
        "title": "Streak: Create Component"
      }
    ],
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/streak.snippets.ts.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/streak.snippets.tsx.json"
      }
    ],
    "configuration": {
      "title": "Streak Snippets",
      "properties": {
        "streak.snippets.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Streak snippets"
        },
        "streak.snippets.pageDirectory": {
          "type": "string",
          "default": "src/pages",
          "description": "Default directory for new Streak pages"
        },
        "streak.snippets.componentDirectory": {
          "type": "string",
          "default": "src/components",
          "description": "Default directory for new Streak components"
        },
        "streak.snippets.widgetDirectory": {
          "type": "string",
          "default": "src/widgets",
          "description": "Default directory for new Streak widgets"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
