{
  "Import WidgetPlaceholder": {
    "prefix": "imWP",
    "body": [
      "import { WidgetPlaceholder } from \"streak-forge/components\";"
    ],
    "description": "Import WidgetPlaceholder from Streak Forge"
  },
  "Import Script": {
    "prefix": "imS",
    "body": [
      "import { Script } from \"streak-forge/components\";"
    ],
    "description": "Import Script from Streak Forge"
  },
  "Import Preload": {
    "prefix": "imPre",
    "body": [
      "import { Preload } from \"streak-forge/components\";"
    ],
    "description": "Import Preload from Streak Forge"
  },
  "Import Dynamic": {
    "prefix": "imDy",
    "body": [
      "import { Dynamic } from \"streak-forge/components\";"
    ],
    "description": "Import Dynamic from Streak Forge"
  },
  "WidgetPlaceholder Element": {
    "prefix": "sfWp",
    "body": [
      "<WidgetPlaceholder id=\"${1:id}\" type=\"${2:type}\" />"
    ],
    "description": "Insert a WidgetPlaceholder element"
  },
  "Preload Element": {
    "prefix": "sfPre",
    "body": [
      "<Preload href=\"${1:/styles/tailwind.css}\" as=\"${2:style}\" media=\"${3}\" />"
    ],
    "description": "Insert a Preload element"
  }
}
